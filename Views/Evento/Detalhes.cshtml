@model Evento  
@{
    ViewData["Title"] = "Detalhes do Evento";
}

<h1>Detalhes do evento</h1>
<p><strong>Quantidade de Vagas: </strong>@Model.QuantidadeVagas</p>
<p><strong>Data do Evento: </strong>@Model.DataEvento</p>
@if(Model.ValorIngresso == null || Model.ValorIngresso == 0)
    {
        <p><strong>Valor:</strong> Gratuito</p>
    }
    else
    {
        <p><strong>Valor:</strong> @Model.ValorIngresso R$ </p>
    }

<a asp-action="Index">Voltar</a>